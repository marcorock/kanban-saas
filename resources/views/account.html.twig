{% extends 'layout.html.twig' %}
{% block content %}
<section class="card card-body shadow-sm">
    <h2 class="h4">{% if mode == 'forgot' %}Recuperar senha{% elseif mode == 'reset' %}Redefinir senha{% elseif mode == 'resend' %}Reenviar confirmação{% else %}Confirmar e-mail{% endif %}</h2>
    {% for error in errors %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endfor %}
    {% if message %}<div class="alert alert-success" role="status">{{ message }}</div>{% endif %}
    {% if not message %}
    <form method="post" action="{% if mode == 'forgot' %}/password/forgot{% elseif mode == 'reset' %}/password/reset{% elseif mode == 'resend' %}/email/resend{% else %}/email/verify{% endif %}">
        <input type="hidden" name="_token" value="{{ csrf }}">
        {% if mode == 'forgot' or mode == 'resend' %}
        <label for="email" class="form-label">E-mail</label>
        <input id="email" type="email" name="email" class="form-control mb-3" autocomplete="email" maxlength="254" required>
        {% else %}
        <input type="hidden" name="token" value="{{ token }}">
        {% if mode == 'reset' %}
        <label for="password" class="form-label">Nova senha</label>
        <input id="password" type="password" name="password" class="form-control mb-3" autocomplete="new-password" minlength="12" maxlength="72" required>
        <p class="form-text">Use pelo menos 12 caracteres e no máximo 72 bytes.</p>
        <label for="confirmation" class="form-label">Confirmar nova senha</label>
        <input id="confirmation" type="password" name="password_confirmation" class="form-control mb-3" autocomplete="new-password" maxlength="72" required>
        {% else %}<p>Confirme seu endereço de e-mail para acessar o painel.</p>{% endif %}
        {% endif %}
        <button class="btn btn-primary" type="submit">{% if mode == 'forgot' or mode == 'resend' %}Enviar link{% elseif mode == 'reset' %}Salvar nova senha{% else %}Confirmar e-mail{% endif %}</button>
    </form>
    {% endif %}
    <div class="mt-3"><a href="/login">Entrar</a> · <a href="/dashboard">Painel</a> · <a href="/email/resend">Reenviar confirmação</a> · <a href="/password/forgot">Recuperar senha</a></div>
</section>
{% endblock %}
