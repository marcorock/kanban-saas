{% extends 'layout.html.twig' %}
{% block content %}
<nav class="d-flex gap-3 mb-4" aria-label="Navegação principal">
    <a href="/dashboard">Painel</a><a href="/projects">Projetos</a>
    <form method="post" action="/logout" class="ms-auto">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Sair</button>
    </form>
</nav>
{% if notice %}<div class="alert alert-success" role="status">{{ notice }}</div>{% endif %}
{% block projects %}{% endblock %}
{% endblock %}
