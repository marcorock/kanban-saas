{% extends 'projects/layout.html.twig' %}
{% block projects %}
{% set roles = {owner: 'Proprietário', admin: 'Administrador', member: 'Membro', viewer: 'Visualizador'} %}
{% set canEdit = canManage and not project.archived_at %}
<h2 class="h4">Participantes — {{ project.name }}</h2>
<a href="/projects/{{ project.id }}">Voltar ao projeto</a>
{% for error in errors %}<div class="alert alert-danger mt-3" role="alert">{{ error }}</div>{% endfor %}
{% if project.archived_at %}<div class="alert alert-info mt-3">Restaure o projeto para gerenciar participantes e convites.</div>{% endif %}
<section class="mt-4">
{% for member in members %}
<div class="card card-body mb-3">
    <div class="d-flex flex-wrap gap-2 justify-content-between"><strong>{{ member.name }}</strong><span>{{ roles[member.role] }}</span></div>
    {% if canManage %}<p class="small text-body-secondary">{{ member.email }}</p>{% endif %}
    {% if canEdit and member.role != 'owner' and (isOwner or member.role != 'admin') %}
    <div class="d-flex flex-wrap gap-3 mt-2">
        <form method="post" action="/projects/{{ project.id }}/members/role" class="d-flex gap-2 align-items-end">
            <input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="user_id" value="{{ member.user_id }}">
            <div><label for="role-{{ member.user_id }}" class="form-label">Papel</label><select id="role-{{ member.user_id }}" name="role" class="form-select">
                {% for value, label in roles %}{% if value != 'owner' and (isOwner or value != 'admin') %}<option value="{{ value }}" {{ value == member.role ? 'selected' : '' }}>{{ label }}</option>{% endif %}{% endfor %}
            </select></div><button type="submit" class="btn btn-outline-primary">Salvar</button>
        </form>
        <form method="post" action="/projects/{{ project.id }}/members/remove" class="align-self-end">
            <input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="user_id" value="{{ member.user_id }}">
            <div class="form-check"><input type="checkbox" id="remove-{{ member.user_id }}" name="confirm" value="remove" class="form-check-input" required><label class="form-check-label" for="remove-{{ member.user_id }}">Confirmar remoção</label></div>
            <button type="submit" class="btn btn-outline-danger mt-1">Remover participante</button>
        </form>
    </div>
    {% if isOwner %}
    <details class="mt-3"><summary>Transferir propriedade para este participante</summary>
        <p class="mt-2">Este participante receberá controle total do projeto. Você passará a administrador; o tenant do projeto permanece o mesmo.</p>
        <form method="post" action="/projects/{{ project.id }}/transfer">
            <input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="user_id" value="{{ member.user_id }}">
            <div class="form-check mb-2"><input type="checkbox" id="transfer-{{ member.user_id }}" name="confirm" value="transfer" class="form-check-input" required><label for="transfer-{{ member.user_id }}" class="form-check-label">Confirmo a transferência de propriedade.</label></div>
            <button class="btn btn-outline-danger" type="submit">Transferir propriedade</button>
        </form>
    </details>
    {% endif %}
    {% endif %}
</div>
{% endfor %}
</section>
{% if canEdit %}
<section class="card card-body mt-4">
    <h3 class="h5">Convidar participante</h3>
    <p>O destinatário deverá entrar ou criar uma conta com o e-mail convidado, confirmar o endereço e aceitar o convite.</p>
    <form method="post" action="/projects/{{ project.id }}/invitations" class="row g-3">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <div class="col-sm-7"><label for="email" class="form-label">E-mail</label><input type="email" id="email" name="email" class="form-control" maxlength="254" required></div>
        <div class="col-sm-5"><label for="invite-role" class="form-label">Papel</label><select id="invite-role" name="role" class="form-select">
            <option value="member">Membro</option><option value="viewer">Visualizador</option>{% if isOwner %}<option value="admin">Administrador</option>{% endif %}
        </select></div>
        <div><button class="btn btn-primary" type="submit">Enviar convite</button></div>
    </form>
</section>
{% endif %}
{% if canManage %}
<section class="mt-4">
    <h3 class="h5">Convites pendentes</h3>
    {% for invitation in invitations %}
    <div class="card card-body mb-3">
        <strong>{{ invitation.email }}</strong><span>{{ roles[invitation.role] }} · Expira em {{ invitation.expires_at|date('d/m/Y H:i', 'UTC') }} UTC</span>
        {% if canEdit and (isOwner or invitation.role != 'admin') %}
        <div class="d-flex flex-wrap gap-2 mt-2">
            <form method="post" action="/projects/{{ project.id }}/invitations">
                <input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="email" value="{{ invitation.email }}"><input type="hidden" name="role" value="{{ invitation.role }}">
                <button class="btn btn-outline-primary" type="submit">Reenviar convite</button>
            </form>
            <form method="post" action="/projects/{{ project.id }}/invitations/cancel">
                <input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="invitation_id" value="{{ invitation.id }}">
                <button class="btn btn-outline-danger" type="submit">Cancelar convite</button>
            </form>
        </div>
        {% endif %}
    </div>
    {% else %}<p>Nenhum convite pendente nesta página.</p>{% endfor %}
</section>
{% endif %}
<nav class="d-flex justify-content-between mt-3" aria-label="Paginação de participantes e convites">
    {% if page > 1 %}<a href="/projects/{{ project.id }}/members?page={{ page - 1 }}">Anterior</a>{% endif %}
    <span>Página {{ page }} de {{ pages }}</span>
    {% if page < pages %}<a href="/projects/{{ project.id }}/members?page={{ page + 1 }}">Próxima</a>{% endif %}
</nav>
{% endblock %}
