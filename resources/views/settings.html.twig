{% extends 'layout.html.twig' %}
{% block content %}
<h2 class="h4">Perfil e configurações pessoais</h2>
{% if success %}<div class="alert alert-success" role="status">{{ success }}</div>{% endif %}
{% for error in errors %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endfor %}
<section class="card card-body mb-4" aria-labelledby="profile-title">
<h3 class="h5" id="profile-title">Meu perfil</h3>
<p>E-mail: <strong>{{ user.email }}</strong> <span class="badge text-bg-success">Verificado</span></p>
<form method="post" action="/settings">
<input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="profile">
<label for="name" class="form-label">Nome</label><input id="name" class="form-control mb-3" name="name" value="{{ name }}" required minlength="2" maxlength="120" autocomplete="name">
<button class="btn btn-primary">Salvar perfil</button>
</form></section>
<section class="card card-body mb-4" aria-labelledby="password-title">
<h3 class="h5" id="password-title">Alterar senha</h3>
<p>A nova senha deve ter pelo menos 12 caracteres e até 72 bytes. Ao alterar, as demais sessões serão encerradas e os links de recuperação anteriores perderão a validade.</p>
<form method="post" action="/settings">
<input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="password">
<label for="current-password" class="form-label">Senha atual</label><input id="current-password" class="form-control mb-3" type="password" name="current_password" required autocomplete="current-password">
<label for="password" class="form-label">Nova senha</label><input id="password" class="form-control mb-3" type="password" name="password" required minlength="12" maxlength="72" autocomplete="new-password">
<label for="confirmation" class="form-label">Confirme a nova senha</label><input id="confirmation" class="form-control mb-3" type="password" name="password_confirmation" required minlength="12" maxlength="72" autocomplete="new-password">
<button class="btn btn-primary">Alterar senha</button>
</form></section>
<section class="card card-body" aria-labelledby="sessions-title">
<h3 class="h5" id="sessions-title">Segurança das sessões</h3>
<p>Encerre o acesso em outros navegadores e dispositivos. Esta sessão continuará ativa.</p>
<form method="post" action="/settings">
<input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="sessions">
<label for="session-password" class="form-label">Confirme sua senha atual</label><input id="session-password" class="form-control mb-3" type="password" name="current_password" required autocomplete="current-password">
<button class="btn btn-outline-danger">Encerrar demais sessões</button>
</form></section>
{% endblock %}
