{% macro icon(name) %}
<svg class="ds-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if name == 'home' %}<path d="m3 10 9-7 9 7v10H3Z"/><path d="M9 20v-7h6v7"/>
{% elseif name == 'projects' %}<rect x="3" y="6" width="18" height="14" rx="3"/><path d="M8 6V4h8v2M3 12h18M10 12v3h4v-3"/>
{% elseif name == 'tasks' %}<rect x="3" y="3" width="18" height="18" rx="4"/><path d="m7 9 2 2 3-4m2 2h3M7 16h10"/>
{% elseif name == 'history' %}<path d="M3 11a9 9 0 1 1 2 7M3 4v7h7m2-4v5l3 2"/>
{% elseif name == 'settings' %}<path d="m10 3-.6 2.2-2 .8-2-.6-2 3.4L5 10.5v3l-1.6 1.7 2 3.4 2-.6 2 .8.6 2.2h4l.6-2.2 2-.8 2 .6 2-3.4-1.6-1.7v-3L21 8.8l-2-3.4-2 .6-2-.8L14 3Z"/><circle cx="12" cy="12" r="3"/>
{% elseif name == 'more' %}<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>
{% elseif name == 'close' %}<path d="m6 6 12 12M6 18 18 6"/>
{% elseif name == 'chevron-right' %}<path d="m9 6 6 6-6 6"/>
{% elseif name == 'arrow-right' %}<path d="M5 12h14m-6-6 6 6-6 6"/>
{% elseif name == 'arrow-left' %}<path d="M19 12H5m6-6-6 6 6 6"/>
{% elseif name == 'eye' %}<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>
{% elseif name == 'eye-off' %}<path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.2A12 12 0 0 1 12 5c6.5 0 10 7 10 7a19 19 0 0 1-3.2 4.1M6.2 6.2A19 19 0 0 0 2 12s3.5 7 10 7a12 12 0 0 0 5.8-1.8"/>
{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>
{% elseif name == 'mail' %}<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/>
{% elseif name == 'lock' %}<rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/>
{% elseif name == 'alert' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4h.01"/>
{% endif %}
</svg>
{% endmacro %}
