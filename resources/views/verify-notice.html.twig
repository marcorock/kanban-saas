{% extends 'layout.html.twig' %}
{% block content %}
<div class="alert alert-info">Confirme seu e-mail para acessar o painel. Confira sua caixa de entrada ou solicite um novo link.</div>
<a href="/email/resend" class="btn btn-primary">Reenviar confirmação</a>
<form class="mt-3" method="post" action="/logout">
    <input type="hidden" name="_token" value="{{ csrf }}">
    <button class="btn btn-outline-secondary" type="submit">Sair</button>
</form>
{% endblock %}
