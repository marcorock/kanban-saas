{% import 'ui/icons.html.twig' as ui %}
<div class="offcanvas offcanvas-end task-panel" tabindex="-1" id="task-panel" aria-labelledby="task-panel-title" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="offcanvas-header tp-header"><div><h2 id="task-panel-title">Detalhes da tarefa</h2></div><button type="button" class="tp-close" aria-label="Fechar detalhes" id="task-panel-close">{{ ui.icon('close') }}</button></div>
    <div class="offcanvas-body tp-body">
        <div id="task-message" class="tp-notice" role="status" aria-live="polite" tabindex="-1" hidden></div>
        <button type="button" class="tp-button tp-secondary" id="task-retry" hidden>Tentar novamente</button>
        <div id="task-content"></div>
    </div>
</div>
{% include 'tasks/templates.html.twig' %}
