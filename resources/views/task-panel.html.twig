<div class="offcanvas offcanvas-end task-panel" tabindex="-1" id="task-panel" aria-labelledby="task-panel-title" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="offcanvas-header"><h2 id="task-panel-title" class="offcanvas-title h5">Detalhes da tarefa</h2><button type="button" class="btn-close" aria-label="Fechar detalhes" id="task-panel-close"></button></div>
    <div class="offcanvas-body">
