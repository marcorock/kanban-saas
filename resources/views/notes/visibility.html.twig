<label class="visually-hidden" for="{{ noteFieldPrefix }}-visibility">Visibilidade</label><select id="{{ noteFieldPrefix }}-visibility" name="visibility">{% for value, label in {'private': 'Privado', 'project': 'Projeto', 'public': 'Público (indisponível)'} %}<option value="{{ value }}"{% if value == noteVisibility|default('private') %} selected{% endif %}{% if value == 'public' %} disabled{% endif %}>{{ label }}</option>{% endfor %}</select>
