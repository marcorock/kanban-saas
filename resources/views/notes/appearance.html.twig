<fieldset class="qn-colors pi-priority"><legend class="visually-hidden">Prioridade</legend>
{% for value, label in {'green': 'Baixa', 'yellow': 'Média', 'orange': 'Alta'} %}
<span class="pi-option" data-color="{{ value }}"><input id="{{ noteFieldPrefix }}-priority-{{ value }}" type="radio" name="color" value="{{ value }}"{% if value == noteColor|default('yellow') %} checked{% endif %}><label for="{{ noteFieldPrefix }}-priority-{{ value }}">{{ label }}</label></span>
{% endfor %}</fieldset>
