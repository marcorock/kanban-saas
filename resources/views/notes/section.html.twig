{% import 'ui/icons.html.twig' as noteUi %}
<section id="brainstorm" class="qn-section" aria-labelledby="brainstorm-title" data-note-section>
    <header class="qn-section-header"><div><p class="qn-eyebrow">UM LUGAR PARA AS IDEIAS</p><h3 id="brainstorm-title">Brainstorm <span>{{ brainstorm.total }}</span></h3><p class="qn-help">{{ noteProjectId ? 'Suas notas e as compartilhadas neste projeto.' : 'Seu Inbox pessoal, sem projeto definido.' }}</p></div>{% if noteCanCreate %}<a class="qn-button qn-primary" href="/notes/new" data-note-open data-note-project="{{ noteProjectId|default('') }}">{{ noteUi.icon('plus') }} Nova nota</a>{% endif %}</header>
    {% if brainstorm.items %}<div class="qn-grid">{% for note in brainstorm.items %}{% set ownsNote = note.user_id == user.id %}
    <article class="qn-card" data-color="{{ note.color }}" data-note-title="{{ note.title }}" data-note-visibility="{{ note.visibility }}" data-note-revision="{{ note.revision }}" aria-label="Nota {{ loop.index }}">
        <header class="qn-card-header"><div><h4 class="qn-card-title" title="{{ note.title }}">{{ note.title ?: 'Sem título' }}</h4><time datetime="{{ note.created_at|date('Y-m-d\\TH:i:s', 'UTC') }}Z">{{ note.created_at|date('d/m/Y H:i', 'America/Sao_Paulo') }}</time></div>{% if ownsNote %}<details class="qn-card-menu"><summary class="qn-icon-button" aria-label="Opções da nota {{ loop.index }}">{{ noteUi.icon('more') }}</summary><div class="qn-menu-panel"><button class="qn-button" type="button" data-note-edit="{{ note.id }}" data-note-project="{{ noteProjectId|default('') }}">{{ noteUi.icon('edit') }} Editar nota</button></div></details>{% endif %}</header>
        <p class="qn-body" tabindex="0" aria-label="Anotação">{{ note.body }}</p>
        <footer class="qn-card-actions" id="note-actions-{{ note.id }}">
            {% if ownsNote %}<button class="qn-icon-button" type="button" data-note-edit="{{ note.id }}" data-note-project="{{ noteProjectId|default('') }}" aria-label="Editar nota {{ loop.index }}" title="Editar nota">{{ noteUi.icon('edit') }}</button>
            <form method="post" action="/notes/{{ note.id }}/delete" data-note-delete><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="project_id" value="{{ noteProjectId|default('') }}"><input type="hidden" name="revision" value="{{ note.revision }}"><button class="qn-icon-button" type="submit" aria-label="Excluir nota {{ loop.index }}" title="Excluir nota">{{ noteUi.icon('trash') }}</button></form>
            {% if ownsNote and noteCanConvert %}<button class="qn-icon-button" type="button" aria-label="Converter em tarefa" title="Converter em tarefa" data-note-convert="{{ note.id }}" data-note-project="{{ noteProjectId|default('') }}">{{ noteUi.icon('arrow-right') }}</button>{% endif %}
            {% endif %}<span class="qn-owner" tabindex="0" aria-label="{{ note.owner_name }} · Proprietário" title="{{ note.owner_name }} · Proprietário">{{ note.owner_name|slice(0,1)|upper }}</span>
        </footer>
    </article>{% endfor %}</div>
    {% else %}<div class="qn-empty"><p>Nenhuma ideia por aqui ainda.</p><p>Capture uma nota pelo botão “Nova nota”, Ctrl+K ou N.</p></div>{% endif %}
    {% if brainstorm.pages > 1 %}<nav class="qn-pagination" aria-label="Paginação do Brainstorm">{% if brainstorm.page > 1 %}<a href="{{ notesBase }}?notes_page={{ brainstorm.page - 1 }}#brainstorm">Anterior</a>{% endif %}<span>{{ brainstorm.page }} de {{ brainstorm.pages }}</span>{% if brainstorm.page < brainstorm.pages %}<a href="{{ notesBase }}?notes_page={{ brainstorm.page + 1 }}#brainstorm">Próxima</a>{% endif %}</nav>{% endif %}
</section>
