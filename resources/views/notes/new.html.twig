{% extends 'layout.html.twig' %}
{% block content %}<section class="qn-dialog qn-postit qn-standalone"><h2>Nova nota rápida</h2><form method="post" action="/notes"><input type="hidden" name="_token" value="{{ csrf }}">{% include 'notes/appearance.html.twig' with {noteFieldPrefix: 'note'} %}<label for="note-body">Sua ideia</label><textarea id="note-body" name="body" maxlength="5000" rows="7" required autofocus></textarea><label for="note-project">Onde guardar</label><select id="note-project" name="project_id"><option value="">Sem projeto / Inbox pessoal</option>{% for destination in destinations %}<option value="{{ destination.id }}">{{ destination.name }}</option>{% endfor %}</select>{% include 'notes/visibility.html.twig' with {noteFieldPrefix: 'note'} %}<p class="qn-help">Privado: só você. Projeto: membros do projeto escolhido.</p><button class="qn-button qn-primary" type="submit">Salvar nota</button><a class="qn-button" href="/tasks#brainstorm">Voltar</a></form></section>{% endblock %}
