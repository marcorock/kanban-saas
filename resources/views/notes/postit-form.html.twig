{% import 'ui/icons.html.twig' as noteUi %}
{% set prefix = noteFieldPrefix|default('quick-note') %}
{% set standalone = noteStandalone|default(false) %}
{% set note = nota|default({}) %}
<form method="post" action="{{ noteAction|default(((workspacePath|default('')) ~ '/notes')) }}" id="{{ prefix }}-form" class="postit-form {{ {green: 'priority-baixa', yellow: 'priority-media', orange: 'priority-alta'}[note.color|default('yellow')]|default('priority-media') }}" data-postit-form{% if not standalone %} data-note-form{% endif %} aria-labelledby="{{ prefix }}-title">
    <input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="revision" value="{{ note.revision|default('') }}">
    <div class="pi-top">
        <div class="pi-meta"><h2 id="{{ prefix }}-title">{{ noteMode|default('Nota rápida') }}</h2><span aria-hidden="true"> · </span><time data-postit-date datetime="{{ note.created_at|default('now')|date('c', 'UTC') }}">{{ note.created_at|default('now')|date('d/m/Y H:i', 'America/Sao_Paulo') }}</time></div>
        {% if standalone %}<a class="pi-close" href="{{ workspacePath|default('') }}/tasks#brainstorm" aria-label="Fechar nota rápida">{{ noteUi.icon('close') }}</a>{% else %}<button class="pi-close" type="button" data-note-close aria-label="Fechar nota rápida">{{ noteUi.icon('close') }}</button>{% endif %}
    </div>
    <label class="visually-hidden" for="{{ prefix }}-heading">Título (opcional)</label>
    <input class="pi-title" id="{{ prefix }}-heading" name="title" type="text" maxlength="200" placeholder="Título (opcional)" value="{{ note.title|default('') }}">
    <label class="visually-hidden" for="{{ prefix }}-body">Sua ideia</label>
    <textarea class="pi-body" id="{{ prefix }}-body" name="body" maxlength="5000" rows="6" required placeholder="Escreva sua ideia…" autofocus aria-describedby="{{ prefix }}-privacy">{{ note.body|default('') }}</textarea>
    <div class="pi-divider" aria-hidden="true"></div>
    {% include 'notes/appearance.html.twig' with {noteFieldPrefix: prefix, noteColor: note.color|default('yellow')} %}
    <div class="pi-selects">
        <label class="pi-select" for="{{ prefix }}-project">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-folder2" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d="M1 3.5A1.5 1.5 0 0 1 2.5 2h2.764c.958 0 1.76.56 2.311 1.184C7.985 3.648 8.48 4 9 4h4.5A1.5 1.5 0 0 1 15 5.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 12.5zM2.5 3a.5.5 0 0 0-.5.5V6h12v-.5a.5.5 0 0 0-.5-.5H9c-.964 0-1.71-.629-2.174-1.154C6.374 3.334 5.82 3 5.264 3zM14 7H2v5.5a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5z"/>
</svg><span class="visually-hidden">Onde guardar</span>
            <select id="{{ prefix }}-project" name="project_id"><option value="">Sem projeto / Inbox pessoal</option>{% for destination in destinations|default([]) %}<option value="{{ destination.id }}"{% if destination.id == note.project_id|default(null) %} selected{% endif %}>{{ destination.name }}</option>{% endfor %}</select>
        </label>
        <div class="pi-select"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lock" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1"/>
</svg>{% include 'notes/visibility.html.twig' with {noteFieldPrefix: prefix, noteVisibility: note.visibility|default('private')} %}</div>
    </div>
    <p class="pi-hint pi-privacy" id="{{ prefix }}-privacy" data-note-privacy-help>Privado por padrão.</p>
    <p class="qn-error" data-note-error role="alert" hidden></p>
    <footer class="pi-footer">
        <div class="pi-actions">{% if standalone %}<a class="btn-pi-ghost" href="{{ workspacePath|default('') }}/tasks#brainstorm">Cancelar</a>{% else %}<button class="btn-pi-ghost" type="button" data-note-close>Cancelar</button>{% endif %}<button class="btn-pi-save" type="submit">Salvar nota</button></div>
    </footer>
</form>
