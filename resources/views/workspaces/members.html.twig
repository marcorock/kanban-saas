{% extends 'layout.html.twig' %}
{% set owner = workspace.owner_id == user.id %}
{% set path = '/workspaces/' ~ workspace.id ~ '/members' %}
{% set roles = {admin: 'Administrador', member: 'Membro'} %}
{% block styles %}<link rel="stylesheet" href="/assets/css/workspace-members.css">{% endblock %}
{% block content %}
<section class="workspace-members" aria-label="Membros e configurações da Área de Trabalho">
<h1>Membros de {{ workspace.name }}</h1>
{% for error in errors %}<p role="alert">{{ error }}</p>{% endfor %}
{% if notice %}<p role="status">{{ notice }}</p>{% endif %}
{% if owner %}
<form method="post" action="{{ path }}/rename"><input type="hidden" name="_token" value="{{ csrf }}"><label for="workspace-name">Nome da Área de Trabalho</label><input id="workspace-name" name="name" value="{{ workspace.name }}" required minlength="2" maxlength="120"><button type="submit">Salvar nome</button></form>
{% endif %}
<ul>
{% for member in members %}
<li>{{ member.name }} — {{ member.user_id == workspace.owner_id ? 'Proprietário' : roles[member.role] }}{% if manager %} ({{ member.email }}){% endif %}
{% if owner and member.user_id != workspace.owner_id %}
<form method="post" action="{{ path }}/role"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="user_id" value="{{ member.user_id }}"><label for="role-{{ member.user_id }}">Papel de {{ member.name }}</label><select id="role-{{ member.user_id }}" name="role">{% for value,label in roles %}<option value="{{ value }}" {{ member.role == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select><button type="submit">Atualizar papel</button></form>
<form method="post" action="{{ path }}/transfer"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="user_id" value="{{ member.user_id }}"><label><input type="checkbox" required> Confirmo transferir a propriedade para {{ member.name }} e permanecer como administrador.</label><button type="submit">Transferir propriedade</button></form>
{% endif %}
</li>
{% endfor %}
</ul>
<nav aria-label="Páginas de membros">{% if page > 1 %}<a href="{{ path }}?page={{ page-1 }}">Anterior</a>{% endif %} Página {{ page }} de {{ pages }} {% if page < pages %}<a href="{{ path }}?page={{ page+1 }}">Próxima</a>{% endif %}</nav>
{% if manager %}
<h2>Convidar pessoa</h2>
<form method="post" action="{{ path }}/invite"><input type="hidden" name="_token" value="{{ csrf }}"><label for="invite-email">E-mail</label><input id="invite-email" name="email" type="email" required maxlength="254"><label for="invite-role">Papel</label><select id="invite-role" name="role"><option value="member">Membro</option>{% if owner %}<option value="admin">Administrador</option>{% endif %}</select><button type="submit">Enviar convite</button></form>
<h2>Convites pendentes</h2>
<p>Para reenviar, envie um novo convite para o mesmo e-mail. O link anterior será invalidado.</p>
<ul>{% for invitation in invitations %}<li>{{ invitation.email }} — {{ roles[invitation.role] }} — expira em {{ invitation.expires_at }} UTC
{% if owner or invitation.role == 'member' %}<form method="post" action="{{ path }}/cancel"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="invitation_id" value="{{ invitation.id }}"><button type="submit">Cancelar convite</button></form>{% endif %}</li>{% else %}<li>Nenhum convite pendente.</li>{% endfor %}</ul>
{% endif %}
</section>
{% endblock %}
