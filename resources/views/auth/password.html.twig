{% import 'ui/icons.html.twig' as ui %}
<div class="ds-field">
    <label for="{{ id }}">{{ label }}</label>
    <div class="ds-password">
        <input id="{{ id }}" name="{{ name }}" type="password" required maxlength="72" {% if minimum|default(false) %}minlength="12"{% endif %} autocomplete="{{ autocomplete }}" {% if hint|default(false) %}aria-describedby="password-hint"{% endif %}>
        <button class="ds-password-toggle" type="button" aria-controls="{{ id }}" aria-label="Mostrar {{ label|lower }}" aria-pressed="false" data-password-toggle data-label="{{ label|lower }}" hidden><span data-eye-show>{{ ui.icon('eye') }}</span><span data-eye-hide hidden>{{ ui.icon('eye-off') }}</span></button>
    </div>
    {% if hint|default(false) %}<p class="ds-field-hint" id="password-hint">Use pelo menos 12 caracteres. Prefira uma senha que você ainda não usa.</p>{% endif %}
</div>
