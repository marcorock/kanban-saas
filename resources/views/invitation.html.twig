{% extends 'layout.html.twig' %}
{% block content %}
<section class="card card-body">
    <h2 class="h4">Convite para projeto</h2>
    {% for error in errors %}<div class="alert alert-warning" role="alert">{{ error }}</div>{% endfor %}
    {% if not signedIn %}
    <p>Entre ou crie uma conta com o mesmo e-mail que recebeu o convite. Confirme seu e-mail antes de aceitar.</p>
    <div class="d-flex gap-2"><a class="btn btn-primary" href="/login">Entrar</a><a class="btn btn-outline-primary" href="/register">Criar conta</a></div>
    {% elseif invitation %}
    {% set roles = {admin: 'Administrador', member: 'Membro', viewer: 'Visualizador'} %}
    <p>Você foi convidado para <strong>{{ invitation.name }}</strong> como <strong>{{ roles[invitation.role] }}</strong>.</p>
    <form method="post" action="/invitations/accept">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <button type="submit" class="btn btn-primary">Aceitar convite</button>
    </form>
    {% endif %}
    {% if signedIn %}
    <a href="/projects" class="mt-3">Meus projetos</a>
    <form method="post" action="/logout" class="mt-3"><input type="hidden" name="_token" value="{{ csrf }}"><button class="btn btn-outline-secondary" type="submit">Sair para usar outra conta</button></form>
    {% endif %}
</section>
{% endblock %}
