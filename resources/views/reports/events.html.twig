{% import 'ui/icons.html.twig' as ui %}
{% if events %}<ol class="hi-timeline">{% for event in events %}
<li><article class="hi-event">
    <span class="hi-event-icon" aria-hidden="true">{{ ui.icon(event.task_id ? 'tasks' : (event.action starts with 'invitation.' ? 'mail' : (event.action starts with 'member.' ? 'users' : 'history'))) }}</span>
    <div class="hi-event-content"><div class="hi-event-heading"><h4>{{ event.label }}</h4><time datetime="{{ event.created_at|date('c', 'UTC') }}">{{ event.created_at|date('d/m/Y H:i', 'UTC') }} UTC</time></div>
    <p class="hi-author">{{ event.author }}</p><p class="hi-context-links"><a href="/projects/{{ event.project_id }}">{{ event.project_name }}</a>{% if event.task_id %}<span aria-hidden="true">·</span><a href="/projects/{{ event.project_id }}/board?task={{ event.task_id }}">{{ event.task_title ?: 'Ver tarefa' }}</a>{% endif %}</p>
    {% if event.restricted|default(false) %}<p class="hi-restricted">{{ ui.icon('lock') }} Detalhes disponíveis somente à administração do projeto.</p>{% endif %}
    {% if event.changes|default([]) %}<details class="hi-changes"><summary>Ver alterações <span>{{ event.changes|length }} {{ event.changes|length == 1 ? 'campo' : 'campos' }}</span></summary><dl>{% for change in event.changes %}<div class="hi-change"><dt>{{ change.label }}</dt><dd><div><span>Antes</span><p>{{ change.before }}</p></div><div><span>Depois</span><p>{{ change.after }}</p></div></dd></div>{% endfor %}</dl></details>{% endif %}
    </div>
</article></li>{% endfor %}</ol>
{% else %}<section class="hi-empty"><span aria-hidden="true">{{ ui.icon('history') }}</span><h4>Nenhuma atividade encontrada.</h4><p>{{ project ? 'As ações dos participantes aparecerão aqui conforme os filtros selecionados.' : 'Suas ações nos projetos acessíveis aparecerão aqui conforme os filtros selecionados.' }}</p><a class="hi-button hi-secondary" href="{{ project ? '/projects/' ~ project.id : '/projects' }}">{{ project ? 'Voltar ao projeto' : 'Explorar projetos' }} {{ ui.icon('arrow-right') }}</a></section>{% endif %}
