APP_NAME="Kanban SaaS"
# Produção: APP_ENV=production, APP_DEBUG=false e APP_URL=https://seu-dominio (sem subdiretório).
# Após instalar/aplicar migrations: php bin/check.php --production (somente leitura).
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kanbansaas
DB_USERNAME=
DB_PASSWORD=

# Mailpit local: use MAIL_HOST=mail no Docker Coruja ou 127.0.0.1 fora dele.
# Produção: configure host, credenciais e remetente SMTP; tls/587 ou ssl/465.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Kanban SaaS"
