{
    "name": "coruja/kanbansaas",
    "description": "Projeto PHP criado com o Coruja Dev Environment",
    "type": "project",
    "require": {
        "php": "^8.3",
        "pecee/simple-router": "^5.4",
        "twig/twig": "^3.24",
        "twbs/bootstrap": "^5.3",
        "twbs/bootstrap-icons": "^1.13",
        "vlucas/phpdotenv": "^5.6",
        "rakit/validation": "^1.4",
        "phpmailer/phpmailer": "^7.0",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "minishlink/web-push": "^11.0",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
